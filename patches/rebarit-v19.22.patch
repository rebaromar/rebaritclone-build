+            }else if("transfer".equals(screen)){
+                invoke("transferPage",new Class<?>[]{boolean.class},true);
+                Field field=MainActivity.class.getDeclaredField("transferDashboard");field.setAccessible(true);
+                ((TransferDashboard)field.get(this)).update(624,"62.4%","218 / 1249  ·  IMG_2048.jpg","24.8 MB/s","02:14","6.4 GB","10.3 GB");
+            }
+        }catch(ReflectiveOperationException e){throw new IllegalStateException(e);}
+    }
+    private void invoke(String name,Class<?>[] types,Object... args)throws ReflectiveOperationException{Method method=MainActivity.class.getDeclaredMethod(name,types);method.setAccessible(true);method.invoke(this,args);}
